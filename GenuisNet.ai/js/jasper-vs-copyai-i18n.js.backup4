        // Meta & Page
        pageTitle: "Jasper AI vs Copy.ai : Quel Outil d'IA d'Écriture est le Meilleur pour le Marketing ? | GenuisNet.ai",
        metaDescription: "",
        heroTitle: "Jasper AI vs Copy.ai : Lequel est le Meilleur pour le Marketing ?",
        heroExcerpt: "Comparaison directe pour créateurs de contenu et équipes marketing.",

        // Headings
        heading1: "La Décision à 36-49 $/Mois",
        heading2: "Comparaison Rapide en un Coup d'Œil",
        heading3: "Jasper AI - Idéal pour Équipes Professionnelles et Contenu Long Format",
        heading4: "Copy.ai - Meilleur Rapport Qualité-Prix pour Entrepreneurs et Contenu Court",
        heading5: "Comparaison de Qualité du Contenu : Test Direct",
        heading6: "Recommandations d'Utilisation : Lequel DEVRIEZ-VOUS Choisir ?",
