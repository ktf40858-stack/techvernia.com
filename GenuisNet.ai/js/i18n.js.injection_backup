// Current language - with fallback for file:// protocol
function getStoredLanguage() {
    // Try URL parameter first (for navigation between pages)
    const urlParams = new URLSearchParams(window.location.search);
    const urlLang = urlParams.get('lang');
    if (urlLang && translations[urlLang]) {
        console.log(`🌍 [INIT] Langue depuis URL: ${urlLang}`);
        return urlLang;
    }

    // Try localStorage
    try {
        const storedLang = localStorage.getItem('language');
        if (storedLang) {
            console.log(`🌍 [INIT] Langue depuis localStorage: ${storedLang}`);
            return storedLang;
        }
    } catch (e) {
        console.warn('⚠️ localStorage non disponible (mode file://?)');
    }

    // Try sessionStorage
    try {
        const sessionLang = sessionStorage.getItem('language');
        if (sessionLang) {
            console.log(`🌍 [INIT] Langue depuis sessionStorage: ${sessionLang}`);
            return sessionLang;
        }
    } catch (e) {
        console.warn('⚠️ sessionStorage non disponible');
    }

    console.log(`🌍 [INIT] Aucune langue sauvegardée, utilisation de 'en'`);
    return 'en';
}

