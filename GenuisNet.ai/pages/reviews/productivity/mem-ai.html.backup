        @media (max-width: 768px) { .review-hero-content { grid-template-columns: 1fr; text-align: center; } .tool-logo-xl { margin: 0 auto; } .review-badges { justify-content: center; } .rating-box { margin: 0 auto; } .quick-stats-grid { grid-template-columns: repeat(2, 1fr); } .features-grid, .pros-cons-grid { grid-template-columns: 1fr; } .screenshots-gallery { grid-template-columns: 1fr; } }
    
