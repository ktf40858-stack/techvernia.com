        }

        h2 .inline-icon {
            width: 1.5em;
            height: 1.5em;
            stroke: url(#icon-gradient);
        }

        /* Gradient pour les icônes dans les titres */
        .icon-gradient-def {
            position: absolute;
            width: 0;
