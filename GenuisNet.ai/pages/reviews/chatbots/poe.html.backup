            stroke-linecap: round;
            stroke-linejoin: round;
        }

        h2 .inline-icon {
            width: 1.5em;
            height: 1.5em;
            stroke: url(#icon-gradient);
        }

        /* Gradient pour les icônes dans les titres */
        .icon-gradient-def {
            position: absolute;
            width: 0;
            height: 0;
        }

        .review-hero { padding: calc(80px + var(--space-4xl)) 0 var(--space-3xl); background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(124, 58, 237, 0.05) 100%); border-bottom: 1px solid var(--border-color); }
        .review-hero-content { display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-2xl); align-items: center; }
        .tool-logo-xl { width: 120px; height: 120px; border-radius: var(--radius-xl); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; color: white; background: linear-gradient(135deg, #8B5CF6, #7C3AED); box-shadow: 0 20px 40px rgba(139, 92, 246, 0.3); }
        .tool-logo-xl img { width: 80%; height: 80%; object-fit: contain; }
        .review-hero-info h1 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; margin-bottom: var(--space-sm); }
        .review-hero-info .company { color: var(--text-tertiary); font-size: var(--text-lg); margin-bottom: var(--space-md); }
        .review-badges { display: flex; gap: var(--space-sm); flex-wrap: wrap; }
        .review-badges .badge { padding: var(--space-xs) var(--space-md); font-size: var(--text-sm); }
        .rating-box { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-xl); padding: var(--space-xl); text-align: center; min-width: 180px; }
        .rating-score { font-size: var(--text-5xl); font-weight: 800; background: linear-gradient(135deg, #8B5CF6, #7C3AED); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1; }
        .rating-stars { color: #F59E0B; font-size: var(--text-xl); margin: var(--space-sm) 0; }
        .rating-label { font-size: var(--text-sm); color: var(--text-tertiary); }
        .quick-stats { background: var(--bg-secondary); padding: var(--space-lg) 0; border-bottom: 1px solid var(--border-color); }
        .quick-stats-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-lg); }
        .quick-stat { text-align: center; }
        .quick-stat-value { font-size: var(--text-xl); font-weight: 700; color: var(--text-primary); }
        .quick-stat-label { font-size: var(--text-xs); color: var(--text-tertiary); margin-top: var(--space-xs); }
        .review-content { display: grid; grid-template-columns: 1fr 350px; gap: var(--space-3xl); padding: var(--space-4xl) 0; }
        .review-main h2 { font-size: var(--text-2xl); font-weight: 700; margin: var(--space-2xl) 0 var(--space-lg); padding-bottom: var(--space-sm); border-bottom: 2px solid var(--border-color); }
        .review-main h2:first-child { margin-top: 0; }
        .review-main h3 { font-size: var(--text-lg); font-weight: 600; margin: var(--space-xl) 0 var(--space-md); color: var(--text-primary); }
        .review-main p { color: var(--text-secondary); line-height: 1.8; margin-bottom: var(--space-lg); }
        .review-main ul, .review-main ol { margin-bottom: var(--space-lg); padding-left: var(--space-xl); }
        .review-main li { color: var(--text-secondary); line-height: 1.7; margin-bottom: var(--space-sm); }
        .features-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-lg); margin: var(--space-xl) 0; }
        .feature-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: var(--space-lg); }
        .feature-card-icon { width: 48px; height: 48px; background: rgba(139, 92, 246, 0.1); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: var(--text-xl); margin-bottom: var(--space-md); }
        .feature-card h4 { font-size: var(--text-md); font-weight: 600; margin-bottom: var(--space-sm); }
        .feature-card p { font-size: var(--text-sm); color: var(--text-secondary); margin: 0; }
        .pros-cons-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-xl); margin: var(--space-xl) 0; }
        .pros-box, .cons-box { background: var(--bg-card); border-radius: var(--radius-lg); padding: var(--space-xl); }
        .pros-box { border: 1px solid rgba(16, 185, 129, 0.3); }
        .cons-box { border: 1px solid rgba(239, 68, 68, 0.3); }
        .pros-box h4, .cons-box h4 { display: flex; align-items: center; gap: var(--space-sm); font-size: var(--text-lg); font-weight: 600; margin-bottom: var(--space-lg); }
        .pros-box h4 { color: #10B981; }
        .cons-box h4 { color: #EF4444; }
        .pricing-table { width: 100%; border-collapse: collapse; margin: var(--space-xl) 0; background: var(--bg-card); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border-color); }
        .pricing-table th, .pricing-table td { padding: var(--space-lg); text-align: left; border-bottom: 1px solid var(--border-color); }
        .pricing-table th { background: var(--bg-tertiary); font-weight: 600; color: var(--text-primary); }
        .pricing-table td { color: var(--text-secondary); }
        .pricing-table .plan-name { font-weight: 600; color: var(--text-primary); }
        .pricing-table .price { font-weight: 700; color: #8B5CF6; }
        .screenshots-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); margin: var(--space-xl) 0; }
        .screenshot { aspect-ratio: 16/10; background: var(--bg-tertiary); border-radius: var(--radius-lg); border: 1px solid var(--border-color); overflow: hidden; }
        .screenshot img { width: 100%; height: 100%; object-fit: cover; }
        .verdict-box { background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(124, 58, 237, 0.1) 100%); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: var(--radius-xl); padding: var(--space-2xl); margin: var(--space-2xl) 0; }
        .verdict-box h3 { font-size: var(--text-xl); font-weight: 700; margin-bottom: var(--space-md); color: var(--text-primary); }
        .verdict-box p { font-size: var(--text-md); margin: 0; }
        .review-sidebar { position: sticky; top: 100px; }
        .sidebar-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-xl); padding: var(--space-xl); margin-bottom: var(--space-xl); }
        .sidebar-card h3 { font-size: var(--text-lg); font-weight: 600; margin-bottom: var(--space-lg); padding-bottom: var(--space-sm); border-bottom: 1px solid var(--border-color); }
        .cta-buttons { display: flex; flex-direction: column; gap: var(--space-sm); }
        .cta-buttons .btn { width: 100%; justify-content: center; }
        .rating-breakdown { margin-top: var(--space-lg); }
        .rating-item { display: flex; align-items: center; gap: var(--space-md); margin-bottom: var(--space-md); }
        .rating-item-label { flex: 1; font-size: var(--text-sm); color: var(--text-secondary); }
        .rating-item-bar { width: 100px; height: 8px; background: var(--bg-tertiary); border-radius: var(--radius-full); overflow: hidden; }
        .rating-item-fill { height: 100%; background: linear-gradient(90deg, #8B5CF6, #7C3AED); border-radius: var(--radius-full); }
        .rating-item-score { font-size: var(--text-sm); font-weight: 600; color: var(--text-primary); min-width: 30px; }
        .related-tool { display: flex; align-items: center; gap: var(--space-md); padding: var(--space-md) 0; border-bottom: 1px solid var(--border-color); }
        .related-tool:last-child { border-bottom: none; }
        .related-tool-logo { width: 40px; height: 40px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: var(--text-sm); color: white; }
        .related-tool-info { flex: 1; }
        .related-tool-name { font-weight: 600; font-size: var(--text-sm); }
        .related-tool-rating { font-size: var(--text-xs); color: var(--text-tertiary); }
        .faq-item { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); margin-bottom: var(--space-md); overflow: hidden; }
        .faq-question { padding: var(--space-lg); cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-weight: 600; }
        .faq-question:hover { background: var(--bg-tertiary); }
        .faq-answer { padding: 0 var(--space-lg) var(--space-lg); color: var(--text-secondary); line-height: 1.7; display: none; }
        .model-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); margin: var(--space-xl) 0; }
        .model-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: var(--space-lg); text-align: center; }
        .model-card-logo { width: 48px; height: 48px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-weight: 700; color: white; margin: 0 auto var(--space-sm); font-size: var(--text-sm); }
        .model-card h5 { font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-xs); }
        .model-card p { font-size: var(--text-xs); color: var(--text-tertiary); margin: 0; }
        @media (max-width: 1024px) { .review-content { grid-template-columns: 1fr; } .review-sidebar { position: static; } }
        @media (max-width: 768px) { .review-hero-content { grid-template-columns: 1fr; text-align: center; } .tool-logo-xl { margin: 0 auto; } .review-badges { justify-content: center; } .rating-box { margin: 0 auto; } .quick-stats-grid { grid-template-columns: repeat(2, 1fr); } .features-grid, .pros-cons-grid { grid-template-columns: 1fr; } .screenshots-gallery, .model-grid { grid-template-columns: 1fr; } }
    
        /* Test Section at Top */
        .test-section-top {
