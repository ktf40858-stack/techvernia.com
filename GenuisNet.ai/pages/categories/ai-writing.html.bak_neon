    <!-- Category Hero -->
    <header class="category-hero">
        <div class="container">
            <div class="category-hero-content">
                <div class="hero-badge">
                    <span class="badge-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#A855F7" stroke-width="2" style="filter: drop-shadow(0 0 6px #A855F7);"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg></span>
                    <span>8 Tools Reviewed</span>
                </div>
                <h1>Best AI Writing Tools & Assistants</h1>
                <p>Discover the most powerful AI writing and content creation tools. From enterprise platforms like Jasper AI to affordable writers like Rytr — find the perfect AI writing assistant to boost your productivity and create exceptional content.</p>
            </div>
        </div>
    </header>

    <!-- Tools Section -->
    <section class="section">
        <div class="container">
            <!-- Filters -->
            <div class="tools-filter">
                <button class="filter-btn active">All Tools</button>
                <button class="filter-btn">Free Tier</button>
                <button class="filter-btn">Best for Marketing</button>
                <button class="filter-btn">Best for Blogging</button>
                <button class="filter-btn">Best for SEO</button>
            </div>

            <!-- Tools Grid -->
            <div class="tools-grid">
                <!-- Jasper AI -->
                <article class="tool-card-full">
                    <div class="tool-card-header">
                        <div class="tool-logo-large jasper"></div>
                        <div class="tool-header-info">
                            <h3>Jasper AI</h3>
                            <span class="company">Enterprise AI Platform</span>
                            <div style="display: flex; gap: var(--space-sm); margin-top: var(--space-sm);">
                                <span class="badge badge-popular">Most Popular</span>
                                <span class="badge badge-rating">4.7 ★</span>
                            </div>
                        </div>
                    </div>
                    <div class="tool-card-body">
                        <p class="tool-description">
                            Jasper AI is the leading enterprise AI content platform trusted by over 100,000 marketers and businesses. Create high-quality blog posts, marketing copy, social media content, and more with powerful AI that learns your brand voice.
                        </p>
                        <div class="tool-features-list">
                            <span class="feature-tag">Brand Voice</span>
                            <span class="feature-tag">SEO Mode</span>
                            <span class="feature-tag">50+ Templates</span>
                            <span class="feature-tag">Team Collaboration</span>
                            <span class="feature-tag">AI Art</span>
                            <span class="feature-tag">Chrome Extension</span>
                        </div>
                        <div class="tool-stats">
                            <div class="stat-item">
                                <div class="stat-value">100K+</div>
                                <div class="stat-label">Businesses</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-value">50+</div>
                                <div class="stat-label">Templates</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-value">29</div>
                                <div class="stat-label">Languages</div>
                            </div>
                        </div>
                        <div class="pros-cons">
                            <div class="pros">
                                <h4>Pros</h4>
                                <ul>
                                    <li>Best-in-class content quality</li>
                                    <li>Learns your brand voice</li>
                                    <li>Excellent team features</li>
                                    <li>Strong SEO optimization</li>
                                </ul>
                            </div>
                            <div class="cons">
                                <h4>Cons</h4>
                                <ul>
                                    <li>Higher pricing tier</li>
                                    <li>Steeper learning curve</li>
                                    <li>No free forever plan</li>
                                </ul>
                            </div>
                        </div>
                        <div class="tool-pricing-row">
                            <div class="pricing-info">
                                <span class="price">$49/mo</span>
                                <span class="period">Creator / $125/mo Teams</span>
                            </div>
                            <div class="tool-actions">
                                <a href="../reviews/writing/jasper.html" class="btn btn-outline">Full Review</a>
                                <a href="https://www.jasper.ai/free-trial" class="btn btn-primary" target="_blank" rel="nofollow sponsored">Try Free →</a>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Copy.ai -->
                <article class="tool-card-full">
                    <div class="tool-card-header">
                        <div class="tool-logo-large copyai"></div>
                        <div class="tool-header-info">
                            <h3>Copy.ai</h3>
                            <span class="company">AI Copywriting Assistant</span>
                            <div style="display: flex; gap: var(--space-sm); margin-top: var(--space-sm);">
                                <span class="badge badge-new">Free Available</span>
                                <span class="badge badge-rating">4.6 ★</span>
                            </div>
                        </div>
                    </div>
                    <div class="tool-card-body">
                        <p class="tool-description">
                            Copy.ai is a powerful AI copywriting tool that helps marketers, entrepreneurs, and content creators generate high-converting copy in seconds. Perfect for ads, emails, product descriptions, and social media content.
                        </p>
                        <div class="tool-features-list">
                            <span class="feature-tag">90+ Templates</span>
                            <span class="feature-tag">Sales Copy</span>
                            <span class="feature-tag">Email Marketing</span>
                            <span class="feature-tag">Social Media</span>
                            <span class="feature-tag">Blog Ideas</span>
                            <span class="feature-tag">Long-form Editor</span>
                        </div>
                        <div class="tool-stats">
                            <div class="stat-item">
                                <div class="stat-value">10M+</div>
                                <div class="stat-label">Users</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-value">90+</div>
                                <div class="stat-label">Tools</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-value">25+</div>
                                <div class="stat-label">Languages</div>
                            </div>
                        </div>
                        <div class="pros-cons">
                            <div class="pros">
                                <h4>Pros</h4>
                                <ul>
                                    <li>Generous free plan</li>
                                    <li>Great for short-form copy</li>
                                    <li>Fast content generation</li>
                                    <li>User-friendly interface</li>
                                </ul>
                            </div>
                            <div class="cons">
                                <h4>Cons</h4>
                                <ul>
                                    <li>Less suitable for long-form</li>
                                    <li>Quality varies by template</li>
                                    <li>Limited customization</li>
                                </ul>
                            </div>
                        </div>
                        <div class="tool-pricing-row">
                            <div class="pricing-info">
                                <span class="price">Free</span>
                                <span class="period">/ Pro plans available</span>
                            </div>
                            <div class="tool-actions">
                                <a href="../reviews/writing/copyai.html" class="btn btn-outline">Full Review</a>
                                <a href="https://www.copy.ai/" class="btn btn-primary" target="_blank" rel="nofollow sponsored">Try Free →</a>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Writesonic -->
                <article class="tool-card-full">
                    <div class="tool-card-header">
                        <div class="tool-logo-large writesonic"></div>
                        <div class="tool-header-info">
                            <h3>Writesonic</h3>
                            <span class="company">AI Writing & SEO Tool</span>
                            <div style="display: flex; gap: var(--space-sm); margin-top: var(--space-sm);">
                                <span class="badge badge-creative">SEO Focused</span>
                                <span class="badge badge-rating">4.5 ★</span>
                            </div>
                        </div>
                    </div>
                    <div class="tool-card-body">
                        <p class="tool-description">
                            Writesonic is an AI-powered writing and SEO tool that helps you create SEO-optimized content, blog posts, ads, and product descriptions. Features include Chatsonic (ChatGPT alternative), Photosonic (AI art), and Audiosonic.
                        </p>
                        <div class="tool-features-list">
                            <span class="feature-tag">SEO Optimizer</span>
                            <span class="feature-tag">Chatsonic</span>
                            <span class="feature-tag">AI Art</span>
                            <span class="feature-tag">Voice Generation</span>
                            <span class="feature-tag">Chrome Extension</span>
                            <span class="feature-tag">API Access</span>
                        </div>
                        <div class="tool-stats">
                            <div class="stat-item">
                                <div class="stat-value">5M+</div>
                                <div class="stat-label">Users</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-value">80+</div>
                                <div class="stat-label">Features</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-value">25+</div>
                                <div class="stat-label">Languages</div>
                            </div>
                        </div>
                        <div class="pros-cons">
                            <div class="pros">
                                <h4>Pros</h4>
                                <ul>
                                    <li>Strong SEO capabilities</li>
                                    <li>Multiple AI tools in one</li>
                                    <li>Affordable pricing</li>
                                    <li>Real-time web search</li>
                                </ul>
                            </div>
                            <div class="cons">
                                <h4>Cons</h4>
                                <ul>
                                    <li>Credit-based system</li>
                                    <li>UI can be overwhelming</li>
                                    <li>Quality inconsistent on free tier</li>
                                </ul>
                            </div>
                        </div>
                        <div class="tool-pricing-row">
                            <div class="pricing-info">
                                <span class="price">Free</span>
                                <span class="period">/ $19/mo Unlimited</span>
                            </div>
                            <div class="tool-actions">
                                <a href="../reviews/writing/writesonic.html" class="btn btn-outline">Full Review</a>
                                <a href="https://app.writesonic.com/signup" class="btn btn-primary" target="_blank" rel="nofollow sponsored">Try Free →</a>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Grammarly -->
                <article class="tool-card-full">
                    <div class="tool-card-header">
                        <div class="tool-logo-large grammarly"></div>
                        <div class="tool-header-info">
                            <h3>Grammarly</h3>
                            <span class="company">Grammar & Writing Assistant</span>
                            <div style="display: flex; gap: var(--space-sm); margin-top: var(--space-sm);">
                                <span class="badge badge-popular">Top Rated</span>
                                <span class="badge badge-rating">4.8 ★</span>
                            </div>
                        </div>
                    </div>
                    <div class="tool-card-body">
                        <p class="tool-description">
                            Grammarly is the world's leading grammar and writing assistant, used by over 30 million people. It checks spelling, grammar, punctuation, clarity, and tone across all your writing with real-time suggestions and AI-powered writing help.
                        </p>
                        <div class="tool-features-list">
                            <span class="feature-tag">Grammar Check</span>
                            <span class="feature-tag">Tone Detection</span>
                            <span class="feature-tag">Plagiarism Check</span>
                            <span class="feature-tag">Writing Insights</span>
                            <span class="feature-tag">Browser Extension</span>
                            <span class="feature-tag">Desktop Apps</span>
                        </div>
                        <div class="tool-stats">
                            <div class="stat-item">
                                <div class="stat-value">30M+</div>
                                <div class="stat-label">Daily Users</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-value">400+</div>
                                <div class="stat-label">Grammar Checks</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-value">70K+</div>
                                <div class="stat-label">Teams</div>
                            </div>
                        </div>
                        <div class="pros-cons">
                            <div class="pros">
                                <h4>Pros</h4>
                                <ul>
                                    <li>Industry-leading accuracy</li>
                                    <li>Works everywhere you write</li>
                                    <li>Excellent free tier</li>
                                    <li>Real-time feedback</li>
                                </ul>
                            </div>
                            <div class="cons">
                                <h4>Cons</h4>
                                <ul>
                                    <li>Not focused on content generation</li>
                                    <li>Can be overly strict</li>
                                    <li>Premium features pricey</li>
                                </ul>
                            </div>
                        </div>
                        <div class="tool-pricing-row">
                            <div class="pricing-info">
                                <span class="price">Free</span>
                                <span class="period">/ $12/mo Premium</span>
                            </div>
