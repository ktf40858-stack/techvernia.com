<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Discover the best AI Cybersecurity tools. From threat detection to endpoint protection, find AI-powered security solutions for your organization.">
    <meta name="keywords" content="AI cybersecurity, AI security tools, threat detection, SIEM, EDR, XDR, Darktrace, CrowdStrike, SentinelOne">
    <meta name="author" content="GenuisNet.ai">
    <title>AI Cybersecurity Tools - Threat Detection, EDR, SIEM | GenuisNet.ai</title>
    <link rel="stylesheet" href="../../css/style.css">
    <link rel="stylesheet" href="../../css/animations.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        .category-hero {
            padding: calc(80px + var(--space-4xl)) 0 var(--space-3xl);
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(124, 58, 237, 0.1) 100%);
            border-bottom: 1px solid var(--border-color);
        }
        .category-hero-content {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: var(--space-3xl);
            align-items: center;
        }
        .category-icon-large {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #EF4444 0%, #7C3AED 100%);
            border-radius: var(--radius-xl);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
        }
        .category-hero h1 {
            font-size: clamp(2.5rem, 5vw, 3.5rem);
            font-weight: 800;
            margin-bottom: var(--space-md);
        }
        .category-hero p {
            font-size: var(--text-lg);
            color: var(--text-secondary);
            max-width: 600px;
            line-height: 1.7;
        }
        .category-stats {
            display: flex;
            gap: var(--space-2xl);
            margin-top: var(--space-xl);
        }
        .category-stat {
            text-align: center;
        }
        .category-stat-number {
            font-size: var(--text-3xl);
            font-weight: 800;
            background: linear-gradient(135deg, #EF4444, #7C3AED);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .category-stat-label {
            font-size: var(--text-sm);
            color: var(--text-tertiary);
        }

        /* Subcategories */
        .subcategories {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-sm);
            margin-top: var(--space-xl);
        }
        .subcategory-tag {
            padding: var(--space-sm) var(--space-md);
            background: var(--bg-tertiary);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-full);
            font-size: var(--text-sm);
            color: var(--text-secondary);
            cursor: pointer;
            transition: all var(--transition-fast);
        }
        .subcategory-tag:hover,
        .subcategory-tag.active {
            background: linear-gradient(135deg, #EF4444, #7C3AED);
            border-color: transparent;
            color: white;
        }

        /* Tools Section */
        .tools-section {
            padding: var(--space-4xl) 0;
        }
        .tools-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: var(--space-xl);
        }
        .tool-card-cyber {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-xl);
            padding: var(--space-xl);
            transition: all var(--transition-normal);
            position: relative;
            overflow: hidden;
        }
        .tool-card-cyber::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #EF4444, #7C3AED);
            opacity: 0;
            transition: opacity var(--transition-fast);
        }
        .tool-card-cyber:hover {
            transform: translateY(-4px);
            border-color: #EF4444;
            box-shadow: 0 20px 40px rgba(239, 68, 68, 0.15);
        }
        .tool-card-cyber:hover::before {
            opacity: 1;
        }
        .tool-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: var(--space-md);
        }
        .tool-logo-cyber {
            width: 56px;
            height: 56px;
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: var(--text-lg);
            color: white;
        }
        .tool-logo-cyber.darktrace { background: url('../../images/logos/cybersecurity/darktrace.png') center/contain no-repeat, linear-gradient(135deg, #F97316, #EA580C); }
        .tool-logo-cyber.crowdstrike { background: url('../../images/logos/cybersecurity/crowdstrike.png') center/contain no-repeat, linear-gradient(135deg, #EF4444, #DC2626); }
        .tool-logo-cyber.sentinelone { background: url('../../images/logos/cybersecurity/sentinelone.png') center/contain no-repeat, linear-gradient(135deg, #8B5CF6, #7C3AED); }
        .tool-logo-cyber.splunk { background: url('../../images/logos/cybersecurity/splunk.png') center/contain no-repeat, linear-gradient(135deg, #84CC16, #65A30D); }
        .tool-logo-cyber.microsoft { background: url('../../images/logos/cybersecurity/microsoft.png') center/contain no-repeat, linear-gradient(135deg, #0EA5E9, #0284C7); }
        .tool-logo-cyber.paloalto { background: url('../../images/logos/cybersecurity/paloalto.png') center/contain no-repeat, linear-gradient(135deg, #F59E0B, #D97706); }
        .tool-logo-cyber.fortinet { background: url('../../images/logos/cybersecurity/fortinet.png') center/contain no-repeat, linear-gradient(135deg, #EF4444, #B91C1C); }
        .tool-logo-cyber.cisco { background: url('../../images/logos/cybersecurity/cisco.png') center/contain no-repeat, linear-gradient(135deg, #06B6D4, #0891B2); }
        .tool-logo-cyber.tenable { background: url('../../images/logos/cybersecurity/tenable.png') center/contain no-repeat, linear-gradient(135deg, #3B82F6, #2563EB); }
        .tool-logo-cyber.snyk { background: url('../../images/logos/cybersecurity/snyk.png') center/contain no-repeat, linear-gradient(135deg, #A855F7, #9333EA); }
        .tool-logo-cyber.okta { background: url('../../images/logos/cybersecurity/okta.png') center/contain no-repeat, linear-gradient(135deg, #3B82F6, #1D4ED8); }
        .tool-logo-cyber.vectra { background: url('../../images/logos/cybersecurity/vectra.png') center/contain no-repeat, linear-gradient(135deg, #10B981, #059669); }
        .tool-logo-cyber.abnormal { background: url('../../images/logos/cybersecurity/abnormal.png') center/contain no-repeat, linear-gradient(135deg, #EC4899, #DB2777); }
        .tool-logo-cyber.wiz { background: url('../../images/logos/cybersecurity/wiz.png') center/contain no-repeat, linear-gradient(135deg, #06B6D4, #14B8A6); }
        .tool-logo-cyber.lacework { background: url('../../images/logos/cybersecurity/lacework.png') center/contain no-repeat, linear-gradient(135deg, #F97316, #FB923C); }
        .tool-logo-cyber.cyberark { background: url('../../images/logos/cybersecurity/cyberark.png') center/contain no-repeat, linear-gradient(135deg, #0EA5E9, #38BDF8); }
        .tool-logo-cyber.ibm { background: url('../../images/logos/cybersecurity/ibm.png') center/contain no-repeat, linear-gradient(135deg, #1F70C1, #052FAD); }
        .tool-logo-cyber.rapid7 { background: url('../../images/logos/cybersecurity/rapid7.png') center/contain no-repeat, linear-gradient(135deg, #FF6B35, #E55934); }
        .tool-logo-cyber.qualys { background: url('../../images/logos/cybersecurity/qualys.png') center/contain no-repeat, linear-gradient(135deg, #ED1C24, #C41E3A); }
        .tool-logo-cyber.cylance { background: url('../../images/logos/cybersecurity/cylance.png') center/contain no-repeat, linear-gradient(135deg, #1a1a1a, #333); }

        .tool-badges-cyber {
            display: flex;
            flex-direction: column;
            gap: var(--space-xs);
            align-items: flex-end;
        }
        .badge-cyber {
            padding: var(--space-xs) var(--space-sm);
            border-radius: var(--radius-full);
            font-size: var(--text-xs);
            font-weight: 600;
        }
        .badge-enterprise {
            background: rgba(239, 68, 68, 0.15);
            color: #EF4444;
        }
        .badge-sme {
            background: rgba(16, 185, 129, 0.15);
            color: #10B981;
        }
        .badge-leader {
            background: rgba(245, 158, 11, 0.15);
            color: #F59E0B;
        }
        .badge-rating-cyber {
            background: var(--bg-tertiary);
            color: var(--text-primary);
        }
        .tool-name-cyber {
            font-size: var(--text-xl);
            font-weight: 700;
            margin-bottom: var(--space-xs);
        }
        .tool-company-cyber {
            font-size: var(--text-sm);
            color: var(--text-tertiary);
            margin-bottom: var(--space-md);
        }
        .tool-desc-cyber {
            font-size: var(--text-sm);
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: var(--space-md);
        }
        .tool-features-cyber {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-xs);
            margin-bottom: var(--space-lg);
        }
        .feature-cyber {
            padding: var(--space-xs) var(--space-sm);
            background: var(--bg-tertiary);
            border-radius: var(--radius-sm);
            font-size: var(--text-xs);
            color: var(--text-secondary);
        }
        .tool-pricing-cyber {
            display: flex;
            align-items: baseline;
            gap: var(--space-xs);
            margin-bottom: var(--space-lg);
            padding: var(--space-md);
            background: var(--bg-tertiary);
            border-radius: var(--radius-md);
        }
        .price-label-cyber {
            font-size: var(--text-xs);
            color: var(--text-tertiary);
        }
        .price-value-cyber {
            font-size: var(--text-lg);
            font-weight: 700;
            color: var(--text-primary);
        }
        .tool-actions-cyber {
            display: flex;
            gap: var(--space-sm);
        }
        .tool-actions-cyber .btn {
            flex: 1;
            justify-content: center;
        }

        /* Section Headers */
        .section-divider {
            margin: var(--space-4xl) 0 var(--space-2xl);
            padding-bottom: var(--space-lg);
            border-bottom: 1px solid var(--border-color);
        }
        .section-divider h2 {
            font-size: var(--text-2xl);
            font-weight: 700;
            margin-bottom: var(--space-sm);
            display: flex;
            align-items: center;
            gap: var(--space-sm);
        }
        .section-divider p {
            color: var(--text-secondary);
        }

        @media (max-width: 1024px) {
            .tools-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .category-hero-content {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .category-icon-large {
                margin: 0 auto var(--space-xl);
            }
            .category-stats {
                justify-content: center;
            }
            .subcategories {
                justify-content: center;
            }
        }
        .hero-badge svg {
            width: 20px;
            height: 20px;
            vertical-align: middle;
            margin-right: 8px;
        }
        @media (max-width: 768px) {
            .tools-grid {
                grid-template-columns: 1fr;
            }
            .category-stats {
                flex-direction: column;
                gap: var(--space-lg);
            }
        }
    </style>
</head>
<body>
    <!-- Neural Network Background -->
    <canvas id="neural-bg"></canvas>

    <!-- Navigation -->
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <a href="../../index.html" class="logo">
                <span class="logo-icon">
                    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="20" cy="20" r="18" stroke="url(#logoGradient)" stroke-width="2"/>
                        <circle cx="20" cy="20" r="8" fill="url(#logoGradient)"/>
                        <circle cx="20" cy="8" r="3" fill="#00D9FF"/>
                        <circle cx="30" cy="25" r="3" fill="#7C3AED"/>
                        <circle cx="10" cy="25" r="3" fill="#10B981"/>
                        <defs>
                            <linearGradient id="logoGradient" x1="0" y1="0" x2="40" y2="40">
                                <stop offset="0%" stop-color="#00D9FF"/>
                                <stop offset="100%" stop-color="#7C3AED"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </span>
                <span class="logo-text">Genuis<span class="highlight">Net</span>.ai</span>
            </a>

            <ul class="nav-menu" id="nav-menu">
                <li class="nav-item">
                    <a href="../../index.html" class="nav-link" data-i18n="nav.home">Home</a>
                </li>
                <li class="nav-item">
                    <a href="../guides.html" class="nav-link" data-i18n="nav.guides">Guides</a>
                </li>
                <li class="nav-item">
                    <a href="../comparisons.html" class="nav-link" data-i18n="nav.compare">Compare</a>
                </li>
                <li class="nav-item">
                    <a href="../about.html" class="nav-link" data-i18n="nav.about">About</a>
                </li>
            </ul>

            <div class="nav-actions">
                <div class="language-selector">
                    <button class="lang-btn" id="lang-btn" aria-label="Select Language">
                        <span class="lang-icon">🌐</span>
                        <span class="lang-current">EN</span>
                        <svg class="chevron" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/>
                        </svg>
                    </button>
                    <div class="lang-dropdown" id="lang-dropdown">
                        <button class="lang-option active" data-lang="en"><span class="flag">🇺🇸</span> English</button>
                        <button class="lang-option" data-lang="es"><span class="flag">🇪🇸</span> Español</button>
                        <button class="lang-option" data-lang="fr"><span class="flag">🇫🇷</span> Français</button>
                        <button class="lang-option" data-lang="de"><span class="flag">🇩🇪</span> Deutsch</button>
                        <button class="lang-option" data-lang="pt"><span class="flag">🇧🇷</span> Português</button>
                        <button class="lang-option" data-lang="zh"><span class="flag">🇨🇳</span> 中文</button>
                        <button class="lang-option" data-lang="ja"><span class="flag">🇯🇵</span> 日本語</button>
                        <button class="lang-option" data-lang="ko"><span class="flag">🇰🇷</span> 한국어</button>
                        <button class="lang-option" data-lang="ar"><span class="flag">🇸🇦</span> العربية</button>
                        <button class="lang-option" data-lang="hi"><span class="flag">🇮🇳</span> हिन्दी</button>
                    </div>
                </div>
                <button class="theme-toggle" id="theme-toggle" aria-label="Toggle Theme">
                    <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"/>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                    <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </button>
                <button class="menu-toggle" id="menu-toggle" aria-label="Toggle Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </nav>

    <!-- Category Hero -->
    <header class="category-hero">
        <div class="container">
            <div class="category-hero-content">
                <div>
                    <h1 data-i18n="cat.cybersecurity">AI Cybersecurity</h1>
                    <p data-i18n="cat.cybersecurity.full">
                        Discover AI-powered security tools for threat detection, endpoint protection, vulnerability management, and security automation. From enterprise SIEM to cloud security platforms.
                    </p>
                    <div class="category-stats">
                        <div class="category-stat">
                            <div class="category-stat-number">30+</div>
                            <div class="category-stat-label" data-i18n="stats.tools">Tools</div>
                        </div>
                        <div class="category-stat">
                            <div class="category-stat-number">8</div>
                            <div class="category-stat-label" data-i18n="cyber.subcategories">Subcategories</div>
                        </div>
                        <div class="category-stat">
                            <div class="category-stat-number">15</div>
                            <div class="category-stat-label" data-i18n="stats.guides">Guides</div>
                        </div>
                    </div>
                    <div class="subcategories">
                        <span class="subcategory-tag active" data-i18n="cyber.all">All Tools</span>
                        <span class="subcategory-tag" data-i18n="cyber.threat">Threat Detection</span>
                        <span class="subcategory-tag" data-i18n="cyber.endpoint">Endpoint (EDR/XDR)</span>
                        <span class="subcategory-tag" data-i18n="cyber.siem">SIEM & SOAR</span>
                        <span class="subcategory-tag" data-i18n="cyber.cloud">Cloud Security</span>
                        <span class="subcategory-tag" data-i18n="cyber.email">Email Security</span>
                        <span class="subcategory-tag" data-i18n="cyber.identity">Identity (IAM)</span>
                        <span class="subcategory-tag" data-i18n="cyber.vuln">Vulnerability</span>
                    </div>
                </div>
                <div class="category-icon-large">
                    🛡️
                </div>
            </div>
        </div>
    </header>

    <!-- Tools Section -->
    <main class="tools-section">
        <div class="container">

            <!-- Threat Detection & SIEM -->
            <div class="section-divider">
                <h2>🎯 <span data-i18n="cyber.section.threat">Threat Detection & SIEM</span></h2>
                <p data-i18n="cyber.section.threat.desc">AI-powered security information and event management platforms</p>
            </div>

