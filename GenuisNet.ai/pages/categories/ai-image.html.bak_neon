    <!-- Category Hero -->
    <header class="category-hero">
        <div class="container">
            <div class="category-hero-content">
                <div class="hero-badge">
                    <span class="badge-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#F472B6" stroke-width="2" style="filter: drop-shadow(0 0 6px #F472B6);"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></span>
                    <span>8 Tools Reviewed</span>
                </div>
                <h1>Best AI Image Generators</h1>
                <p>Discover the most powerful AI image generation tools. From artistic masterpieces with Midjourney to professional design with Adobe Firefly — find the perfect AI image generator for your creative needs.</p>
            </div>
        </div>
