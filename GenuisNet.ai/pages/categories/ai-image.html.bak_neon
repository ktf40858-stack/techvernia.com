            </div>

            <!-- Tools Grid -->
            <div class="tools-grid">
                <!-- Midjourney -->
                <article class="tool-card-full">
                    <div class="tool-card-header">
                        <div class="tool-logo-large midjourney"></div>
                        <div class="tool-header-info">
                            <h3>Midjourney</h3>
                            <span class="company">by Midjourney Inc.</span>
                            <div style="display: flex; gap: var(--space-sm); margin-top: var(--space-sm);">
                                <span class="badge badge-popular">Most Artistic</span>
                                <span class="badge badge-rating">4.8 ★</span>
                                <span class="country-flag" style="font-size: 1.2em; opacity: 0.7;">🇺🇸</span>
                            </div>
                        </div>
                    </div>
                    <div class="tool-card-body">
                        <p class="tool-description">
                            Midjourney is renowned for creating stunning, artistic AI-generated images. Operating through Discord, it offers unparalleled aesthetic quality and creative control. Perfect for artists, designers, and creative professionals seeking exceptional visual results.
                        </p>
                        <div class="tool-features-list">
                            <span class="feature-tag">Artistic Quality</span>
                            <span class="feature-tag">Discord Interface</span>
                            <span class="feature-tag">Style Variations</span>
                            <span class="feature-tag">High Resolution</span>
                            <span class="feature-tag">Commercial Use</span>
                            <span class="feature-tag">Fast Generation</span>
                        </div>
                        <div class="tool-stats">
                            <div class="stat-item">
                                <div class="stat-value">16M+</div>
                                <div class="stat-label">Users</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-value">4.8/5</div>
                                <div class="stat-label">Rating</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-value">Commercial</div>
                                <div class="stat-label">License</div>
                            </div>
                        </div>
                        <div class="pros-cons">
                            <div class="pros">
                                <h4>Pros</h4>
                                <ul>
                                    <li>Best artistic quality</li>
                                    <li>Incredible detail and aesthetics</li>
                                    <li>Active community</li>
                                    <li>Regular model updates</li>
                                </ul>
                            </div>
                            <div class="cons">
                                <h4>Cons</h4>
                                <ul>
                                    <li>No free tier</li>
                                    <li>Discord-only interface</li>
                                    <li>Steep learning curve</li>
                                </ul>
                            </div>
                        </div>
                        <div class="tool-pricing-row">
                            <div class="pricing-info">
                                <span class="price">$10/mo</span>
                                <span class="period">Basic Plan</span>
                            </div>
                            <div class="tool-actions">
                                <a href="../reviews/image/midjourney.html" class="btn btn-outline">Full Review</a>
                                <a href="https://www.midjourney.com/" class="btn btn-primary" target="_blank" rel="nofollow sponsored">Try Now →</a>
                            </div>
