}

/* Blog Listing */

.blog-subheader__author-links a {
  background-color: #14b4e3;
}

.blog-subheader__author-links a:hover {
  background-color: #14b4e3;
}

/* Blog Pagination */

.blog-pagination__link {
  color: #14b4e3;
}

