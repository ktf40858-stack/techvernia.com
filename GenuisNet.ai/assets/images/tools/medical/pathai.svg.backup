.blog-index__post-author-name,
.blog-post__author-name {
  font-family: 'Nunito Sans', sans-serif; font-style: normal; font-weight: normal; text-decoration: none;
  color: #000000;
}

.blog-post__author-links svg {
  fill: #000000;
}

