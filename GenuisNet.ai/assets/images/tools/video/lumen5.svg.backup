    // Cookie consent utility functions
// Centralized cookie consent checking to avoid code duplication

/**
 * Checks if a specific consent type is granted
 * @param {string} consentType - The consent type to check ('storedMarketingConsent', 'storedPerformanceConsent')
 * @returns {boolean} - Whether consent is granted
 */
function checkCookieConsent(consentType) {
    try {
        const cookiesList = Object.fromEntries(document.cookie.split('; ').map(c => c.split('=')));
        const cookieConsentValues = cookiesList['third_party_cookies_consent'];

        if (!cookieConsentValues) {
            return false;
        }
        
        const decodedCookieConsentValues = decodeURIComponent(cookieConsentValues);
        const parsedCookieConsentValues = JSON.parse(decodedCookieConsentValues);

        return parsedCookieConsentValues && parsedCookieConsentValues[consentType] === true;
    } catch (error) {
        console.warn(`Failed to parse cookie consent values for ${consentType}:`, error);
        return false;
    }
}

/**
 * Checks if marketing consent is granted
 * @returns {boolean} - Whether marketing consent is granted
 */
function hasMarketingConsent() {
    return checkCookieConsent('storedMarketingConsent');
}

/**
 * Checks if performance consent is granted
 * @returns {boolean} - Whether performance consent is granted
 */
function hasPerformanceConsent() {
    return checkCookieConsent('storedPerformanceConsent');
}

// Make functions available globally
window.CookieConsentUtils = {
    checkCookieConsent: checkCookieConsent,
    hasMarketingConsent: hasMarketingConsent,
    hasPerformanceConsent: hasPerformanceConsent
};
</script>
