                        $crisp.push(["set", "user:email", [SERVER.ANALYTICS['email'], SERVER.USER['crisp_identity_signature']]]);
                        $crisp.push(["set", "user:nickname", [SERVER.ANALYTICS['name']]]);
                        $crisp.push(["set", "user:avatar", [SERVER.ANALYTICS['photo_url']]]);
                        $crisp.push(["set", "session:data", [
                            [
                                // NOTE: default to '' if undefined/null since $crisp errors for those values
                                ["created_at", new Date(SERVER.ANALYTICS['created']).getTime() ?? ''],
                                ["user_id", SERVER.ANALYTICS.id ?? ''],
                                ["plan_name", SERVER.ANALYTICS.plan_name ?? ''],
                                ["video_count", SERVER.ANALYTICS.video_count ?? ''],
                                ["downloaded_video_count", SERVER.ANALYTICS.downloaded_video_count ?? ''],
                                ["saved_template_count", SERVER.ANALYTICS.saved_template_count ?? ''],
                                ["business_name", SERVER.ANALYTICS.business_name ?? ''],
                                ["first_name", SERVER.ANALYTICS.first_name ?? ''],
                                ["last_name", SERVER.ANALYTICS.last_name ?? ''],
                                ["username", SERVER.ANALYTICS.username ?? ''],
                                ["workspace_count", SERVER.ANALYTICS.workspace_count ?? ''],
                            ]
                        ]]);
                    }

                    // Hubspot
                    if(window._hsq) {
                        var hubspot_data = _objectWithoutProperties(
                            SERVER.ANALYTICS,
                            ["saved_template_count", "business_name", "created",
