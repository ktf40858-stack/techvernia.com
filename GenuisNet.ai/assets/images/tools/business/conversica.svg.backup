<script>
// ===== CONFIG =====
// Replace these with your actual Webflow button ID and iframe selector
const BUTTON_ID = "book-call-btn"; // the "Book a Call" button
const IFRAME_SELECTOR = "#chili-iframe"; // your iframe inside modal

// ===== MODAL OPEN TRACKING =====
document.addEventListener("DOMContentLoaded", () => {
  const btn = document.getElementById(BUTTON_ID);
  if (btn) {
    btn.addEventListener("click", () => {
      console.log("Modal opened for Stephen Walters");
      // Add your GA / LinkedIn / Pixel tracking here
      // Example: gtag('event', 'modal_open', { 'page': 'Stephen Walters Landing Page' });
    });
  }
});

// ===== CHILI PIPER BOOKING TRACKING =====
window.addEventListener("message", (event) => {
  // Only listen to messages from Chili Piper
  if (event.origin !== "https://conversica.chilipiper.com") return;

  const data = event.data;
  if (typeof data === "object" && data.action === "booked") {
    console.log("Booking successful for Stephen Walters");
    // Add your GA / LinkedIn / Pixel tracking here
    // Example: gtag('event', 'booking', { 'page': 'Stephen Walters Landing Page' });
    
    // Optional: close modal automatically
    const iframe = document.querySelector(IFRAME_SELECTOR);
    if (iframe) {
      const modal = iframe.closest(".modal-wrapper"); // assumes your wrapper has this class
      if (modal) modal.style.display = "none";
    }
  }
});
</script>


