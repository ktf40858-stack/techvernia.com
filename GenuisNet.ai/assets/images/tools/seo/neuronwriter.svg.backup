<style>
//* NEW overlay badge styling */
.nw-most-popular-badge {
  position: absolute;
  height: 80px;
  left: 50%;
  transform: translateX(-50%);
  color: #262a2e !important;
  font-weight: bold;

  border-radius: 20px;
  padding:0 0 0 0;
  pointer-events: none; /* So it doesn't block button clicks below */
  font-size: 1.15em;
	text-align:center;
	z-index:100;
}
/* Make sure the containing block allows the badge to be positioned over it */
.elementor-element-42d67e6, .elementor-element-53ba215, .elementor-element-e09120c, .elementor-element-cbbf3a0XX {
  position: relative;
	top:-28px;
z-index:1;
}

.nw-most-popular-badge div p{
		text-align:center;
	  color: #262a2e !important;
	margin-top:0px !important;
}
.elementor-element-7aa9274, .elementor-element-53ba215, .elementor-element-cbbf3a0  {
