<script>
// PLIK 3: JAVASCRIPT
// GDZIE WKLEIĆ: Elementor → Custom Code → Add New
// Location: Body - End
// Display Conditions: Entire Site (lub tylko strona główna)

(function() {
    'use strict';
    
    // ⚠️ ZMIEŃ DATĘ TUTAJ ⚠️
    const COUNTDOWN_DATE = new Date("2025/12/03 23:59:00").getTime();
    
    let intervalId = null;
    
    function padZero(num) {
        return num.toString().padStart(2, '0');
    }
    
    function updateCounter() {
        const daysEl = document.getElementById('bf-mobile-days-v3');
        const hoursEl = document.getElementById('bf-mobile-hours-v3');
        const minutesEl = document.getElementById('bf-mobile-minutes-v3');
        const secondsEl = document.getElementById('bf-mobile-seconds-v3');
        
        // Jeśli którykolwiek element nie istnieje, zakończ
        if (!daysEl || !hoursEl || !minutesEl || !secondsEl) {
            return;
        }
        
        const now = new Date().getTime();
        const diff = COUNTDOWN_DATE - now;
        
        // Jeśli czas minął
        if (diff < 0) {
            daysEl.innerText = '0';
            hoursEl.innerText = '00';
            minutesEl.innerText = '00';
            secondsEl.innerText = '00';
            if (intervalId) clearInterval(intervalId);
            return;
        }
        
        // Oblicz wartości
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        const seconds = Math.floor((diff / 1000) % 60);
        
        // Aktualizuj DOM
        daysEl.innerText = days;
        hoursEl.innerText = padZero(hours);
        minutesEl.innerText = padZero(minutes);
        secondsEl.innerText = padZero(seconds);
    }
    
    function startCounter() {
        // Uruchom od razu
        updateCounter();
        
        // Następnie co sekundę
        if (intervalId) clearInterval(intervalId);
        intervalId = setInterval(updateCounter, 1000);
    }
    
    // Czekaj aż DOM będzie gotowy
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(startCounter, 500);
        });
    } else {
        // DOM już gotowy
        setTimeout(startCounter, 500);
    }
    
})();
</script>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
