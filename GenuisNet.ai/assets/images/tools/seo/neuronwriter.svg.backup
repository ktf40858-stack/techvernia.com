<style>
@media (max-width: 1024px) {
    /* Upewnij się, że wrapper link jest na wierzchu */
    .elementskit-megamenu-panel .ekit-wrapper-link {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 10 !important;
        pointer-events: auto !important;
        cursor: pointer !important;
    }
    
    /* Upewnij się, że parent ma position: relative */
    .elementskit-megamenu-panel .ekit-stylish-list-content-wrapper {
        position: relative !important;
    }
    
    /* Upewnij się, że zawartość nie blokuje kliknięć */
    .elementskit-megamenu-panel .ekit-stylish-list-content {
        position: relative !important;
        z-index: 1 !important;
        pointer-events: none !important;
    }
    
    /* Przywróć pointer-events dla elementów interaktywnych wewnątrz */
    .elementskit-megamenu-panel .ekit-stylish-list-content * {
        pointer-events: auto !important;
    }
}</style>
