<!-- ENHANCED HIGH-TECH HERO SECTION -->
<!-- Replace the existing <header class="hero"> section with this -->

<header class="hero hero-enhanced">
    <!-- 3D Holographic Grid Background -->
    <canvas id="holographic-grid" class="holographic-grid"></canvas>

    <!-- Floating Data Streams -->
    <div class="data-streams">
        <div class="data-stream" style="--delay: 0s; --duration: 8s;"></div>
        <div class="data-stream" style="--delay: 2s; --duration: 10s;"></div>
        <div class="data-stream" style="--delay: 4s; --duration: 9s;"></div>
        <div class="data-stream" style="--delay: 1s; --duration: 11s;"></div>
    </div>

    <!-- Animated Circuit Patterns -->
    <svg class="circuit-pattern" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <linearGradient id="circuit-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#00D9FF;stop-opacity:0.6" />
                <stop offset="100%" style="stop-color:#A855F7;stop-opacity:0.3" />
            </linearGradient>
            <filter id="glow">
                <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
                <feMerge>
                    <feMergeNode in="coloredBlur"/>
                    <feMergeNode in="SourceGraphic"/>
                </feMerge>
            </filter>
        </defs>

        <!-- Animated Circuit Lines -->
        <path class="circuit-line" d="M0,200 L300,200 L400,100 L600,100" stroke="url(#circuit-gradient)" stroke-width="2" fill="none" filter="url(#glow)">
            <animate attributeName="stroke-dashoffset" from="1000" to="0" dur="4s" repeatCount="indefinite"/>
        </path>
        <path class="circuit-line" d="M1000,300 L700,300 L600,400 L400,400" stroke="url(#circuit-gradient)" stroke-width="2" fill="none" filter="url(#glow)">
            <animate attributeName="stroke-dashoffset" from="1000" to="0" dur="5s" repeatCount="indefinite"/>
        </path>
        <path class="circuit-line" d="M200,1000 L200,700 L300,600 L300,400" stroke="url(#circuit-gradient)" stroke-width="2" fill="none" filter="url(#glow)">
            <animate attributeName="stroke-dashoffset" from="1000" to="0" dur="6s" repeatCount="indefinite"/>
        </path>

        <!-- Circuit Nodes -->
        <circle class="circuit-node" cx="300" cy="200" r="4" fill="#00D9FF">
            <animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite"/>
        </circle>
        <circle class="circuit-node" cx="600" cy="100" r="4" fill="#A855F7">
            <animate attributeName="opacity" values="0.3;1;0.3" dur="2.5s" repeatCount="indefinite"/>
        </circle>
        <circle class="circuit-node" cx="700" cy="300" r="4" fill="#F472B6">
            <animate attributeName="opacity" values="0.3;1;0.3" dur="3s" repeatCount="indefinite"/>
        </circle>
    </svg>

    <!-- Glowing Orbs -->
    <div class="floating-orbs">
        <div class="orb orb-1" style="--x: 10%; --y: 20%; --size: 150px; --color: #00D9FF;"></div>
        <div class="orb orb-2" style="--x: 85%; --y: 60%; --size: 200px; --color: #A855F7;"></div>
        <div class="orb orb-3" style="--x: 50%; --y: 80%; --size: 120px; --color: #F472B6;"></div>
    </div>

    <div class="container hero-container">
        <div class="hero-content">
            <!-- Animated Title with Glitch Effect -->
            <div class="hero-label" data-aos="fade-down">
                <span class="pulse-dot"></span>
                <span data-i18n="hero.label">AI Tools Directory</span>
                <div class="label-particles">
                    <span></span><span></span><span></span>
                </div>
            </div>

            <h1 class="hero-title glitch-effect" data-text="Discover the Future of AI" data-aos="fade-up" data-aos-delay="100">
                <span class="gradient-text">Discover the Future</span>
                <br>
                <span class="gradient-text-alt">of AI Tools</span>
                <div class="title-underline">
                    <div class="underline-glow"></div>
                </div>
            </h1>

            <p class="hero-subtitle typewriter" data-aos="fade-up" data-aos-delay="200">
                <span class="typewriter-text"></span>
                <span class="cursor">|</span>
            </p>

            <!-- Animated Stats Bar -->
            <div class="hero-stats-enhanced" data-aos="fade-up" data-aos-delay="300">
                <div class="stat-card">
                    <div class="stat-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-number counter" data-count="116">0</div>
                        <div class="stat-label">AI Tools</div>
                    </div>
                    <div class="stat-glow"></div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7"/>
                            <rect x="14" y="3" width="7" height="7"/>
                            <rect x="14" y="14" width="7" height="7"/>
                            <rect x="3" y="14" width="7" height="7"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-number counter" data-count="13">0</div>
                        <div class="stat-label">Categories</div>
                    </div>
                    <div class="stat-glow"></div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 20h9"/>
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-number counter" data-count="50">0</div>
                        <div class="stat-label">Expert Reviews</div>
                    </div>
                    <div class="stat-glow"></div>
                </div>
            </div>

            <!-- Enhanced CTA Buttons -->
            <div class="hero-cta-enhanced" data-aos="fade-up" data-aos-delay="400">
                <a href="#categories" class="btn-futuristic btn-primary">
                    <span class="btn-content">
                        <span class="btn-text">Explore AI Tools</span>
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </span>
                    <span class="btn-glow"></span>
                    <span class="btn-particles">
                        <span></span><span></span><span></span><span></span>
                    </span>
                </a>

                <a href="pages/guides.html" class="btn-futuristic btn-secondary">
                    <span class="btn-content">
                        <span class="btn-text">Read Guides</span>
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                        </svg>
                    </span>
                    <span class="btn-glow"></span>
                </a>
            </div>

            <!-- Trusted By Logos (Scrolling) -->
            <div class="trusted-section" data-aos="fade-up" data-aos-delay="500">
                <div class="trusted-label">Featuring tools from</div>
                <div class="trusted-logos-scroll">
                    <div class="logos-track">
                        <img src="assets/images/tools/chatbots/chatgpt.svg" alt="ChatGPT" class="trusted-logo">
                        <img src="assets/images/tools/chatbots/claude.svg" alt="Claude" class="trusted-logo">
                        <img src="assets/images/tools/chatbots/gemini.svg" alt="Gemini" class="trusted-logo">
                        <img src="assets/images/tools/image/midjourney.svg" alt="Midjourney" class="trusted-logo">
                        <img src="assets/images/tools/coding/cursor.svg" alt="Cursor" class="trusted-logo">
                        <img src="assets/images/tools/coding/github-copilot.png" alt="GitHub Copilot" class="trusted-logo">
                        <!-- Duplicate for seamless loop -->
                        <img src="assets/images/tools/chatbots/chatgpt.svg" alt="ChatGPT" class="trusted-logo">
                        <img src="assets/images/tools/chatbots/claude.svg" alt="Claude" class="trusted-logo">
                        <img src="assets/images/tools/chatbots/gemini.svg" alt="Gemini" class="trusted-logo">
                        <img src="assets/images/tools/image/midjourney.svg" alt="Midjourney" class="trusted-logo">
                        <img src="assets/images/tools/coding/cursor.svg" alt="Cursor" class="trusted-logo">
                        <img src="assets/images/tools/coding/github-copilot.png" alt="GitHub Copilot" class="trusted-logo">
                    </div>
                </div>
            </div>
        </div>

        <!-- 3D AI Brain Visualization -->
        <div class="hero-visual-enhanced">
            <div class="ai-brain-container">
                <canvas id="ai-brain-3d" class="ai-brain-canvas"></canvas>
                <div class="brain-data-points">
                    <div class="data-point" style="--x: 30%; --y: 20%;">
                        <div class="point-pulse"></div>
                        <div class="point-label">GPT-4</div>
                    </div>
                    <div class="data-point" style="--x: 70%; --y: 40%;">
                        <div class="point-pulse"></div>
                        <div class="point-label">Claude 3.5</div>
                    </div>
                    <div class="data-point" style="--x: 50%; --y: 70%;">
                        <div class="point-pulse"></div>
                        <div class="point-label">Gemini</div>
                    </div>
                </div>
            </div>

            <!-- Floating Cards Preview -->
            <div class="floating-preview-cards">
                <div class="preview-card card-1">
                    <div class="card-icon">💬</div>
                    <div class="card-title">AI Chatbots</div>
                    <div class="card-count">8 Tools</div>
                </div>
                <div class="preview-card card-2">
                    <div class="card-icon">🎨</div>
                    <div class="card-title">Image Gen</div>
                    <div class="card-count">8 Tools</div>
                </div>
                <div class="preview-card card-3">
                    <div class="card-icon">💻</div>
                    <div class="card-title">AI Coding</div>
                    <div class="card-count">8 Tools</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator-enhanced">
        <div class="mouse-icon">
            <div class="mouse-wheel"></div>
        </div>
        <div class="scroll-text">Scroll to explore</div>
        <div class="scroll-arrow-animated">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>
</header>
