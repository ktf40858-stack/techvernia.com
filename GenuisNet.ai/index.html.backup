<!-- Floating Data Streams -->
<div class="data-streams">
<div class="data-stream" style="--delay: 0s; --duration: 8s;"></div>
<div class="data-stream" style="--delay: 2s; --duration: 10s;"></div>
<div class="data-stream" style="--delay: 4s; --duration: 9s;"></div>
