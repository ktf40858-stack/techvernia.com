</div>
<!-- Animated Circuit Patterns -->
<svg class="circuit-pattern" viewbox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
<defs>
<lineargradient id="circuit-gradient" x1="0%" x2="100%" y1="0%" y2="100%">
<stop offset="0%" style="stop-color:#00D9FF;stop-opacity:0.6"></stop>
<stop offset="100%" style="stop-color:#A855F7;stop-opacity:0.3"></stop>
</lineargradient>
<filter id="glow">
<fegaussianblur result="coloredBlur" stddeviation="3"></fegaussianblur>
<femerge>
<femergenode in="coloredBlur"></femergenode>
<femergenode in="SourceGraphic"></femergenode>
</femerge>
</filter>
</defs>
<!-- Animated Circuit Lines -->
<path class="circuit-line" d="M0,200 L300,200 L400,100 L600,100" fill="none" filter="url(#glow)" stroke="url(#circuit-gradient)" stroke-width="2">
<animate attributename="stroke-dashoffset" dur="4s" from="1000" repeatcount="indefinite" to="0"></animate>
</path>
<path class="circuit-line" d="M1000,300 L700,300 L600,400 L400,400" fill="none" filter="url(#glow)" stroke="url(#circuit-gradient)" stroke-width="2">
<animate attributename="stroke-dashoffset" dur="5s" from="1000" repeatcount="indefinite" to="0"></animate>
</path>
<path class="circuit-line" d="M200,1000 L200,700 L300,600 L300,400" fill="none" filter="url(#glow)" stroke="url(#circuit-gradient)" stroke-width="2">
<animate attributename="stroke-dashoffset" dur="6s" from="1000" repeatcount="indefinite" to="0"></animate>
</path>
<!-- Circuit Nodes -->
<circle class="circuit-node" cx="300" cy="200" fill="#00D9FF" r="4">
<animate attributename="opacity" dur="2s" repeatcount="indefinite" values="0.3;1;0.3"></animate>
</circle>
<circle class="circuit-node" cx="600" cy="100" fill="#A855F7" r="4">
<animate attributename="opacity" dur="2.5s" repeatcount="indefinite" values="0.3;1;0.3"></animate>
</circle>
<circle class="circuit-node" cx="700" cy="300" fill="#F472B6" r="4">
<animate attributename="opacity" dur="3s" repeatcount="indefinite" values="0.3;1;0.3"></animate>
</circle>
</svg>
