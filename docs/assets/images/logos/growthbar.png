        }

        p.pricing-list span {
            font-family: 'Open Sans', sans-serif;
            font-size: 13px;
            line-height: 30px;
        }

        .pricing-table a.wp-block-button__link.has-white-color.has-text-color.has-background:hover {
            background-color: #4285f4 !important;
            color: #fff !important;
            border-radius: 9999px;
        }

        .pricing-table a.wp-block-button__link.has-white-color.has-text-color.has-background {
            border: 2px solid #4285f4;
            color: #4285f4 !important;
            background-color: #fff !important;
            font-weight: 600;
            padding: 10px 50px;
        }

        .rainbow_button_wrap .wp-block-button__link,
        .pricing-table a.wp-block-button__link.has-white-color.has-text-color.has-background,
        .rainbow_button,
        #menu-item-16529.rainbow_button_wrap a {
            border: none;
            color: #fff !important;
            background-color: #000 !important;
            font-weight: 600;
            padding: 10px 50px;
            position:relative;
            z-index: 1;
        }

        .rainbow_button_wrap .wp-block-button__link:before,
        .pricing-table a.wp-block-button__link.has-white-color.has-text-color.has-background:before,
        .rainbow_button:before, #menu-item-16529.rainbow_button_wrap a:before {
            content: '';
            background: linear-gradient(45deg, #ff0000, #ff7300, #fffb00, #48ff00, #00ffd5, #002bff, #7a00ff, #ff00c8, #ff0000);
            position: absolute;
            top: -2px;
            left:-2px;
            background-size: 400%;
            z-index: -1;
            filter: blur(5px);
            width: calc(100% + 4px);
            height: calc(100% + 4px);
            animation: glowing 20s linear infinite;
            opacity: 0;
            transition: opacity .3s ease-in-out;
            border-radius: inherit;
        }

        .rainbow_button_wrap .wp-block-button__link:active,
        .pricing-table a.wp-block-button__link.has-white-color.has-text-color.has-background:active,
        .rainbow_button:active, #menu-item-16529.rainbow_button_wrap a:active {
            color: #fff !important
        }

        .rainbow_button_wrap .wp-block-button__link:after,
        .pricing-table a.wp-block-button__link.has-white-color.has-text-color.has-background:active:after,
        .rainbow_button:active:after, #menu-item-16529.rainbow_button_wrap a:active:after {
            background: transparent !important;
        }

        .rainbow_button_wrap .wp-block-button__link:hover:before,
        .pricing-table a.wp-block-button__link.has-white-color.has-text-color.has-background:hover:before,
        .rainbow_button:hover:before, #menu-item-16529.rainbow_button_wrap a:hover:before  {
            opacity: 1;
        }

        .rainbow_button_wrap .wp-block-button__link:after,
        .pricing-table a.wp-block-button__link.has-white-color.has-text-color.has-background:after,
        .rainbow_button:after, #menu-item-16529.rainbow_button_wrap a:after {
            z-index: -1;
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background: #000 !important;
            left: 0;
            top: 0;
            border-radius: inherit;
        }

        @keyframes glowing {
            0% { background-position: 0 0; }
            50% { background-position: 400% 0; }
            100% { background-position: 0 0; }
        }

        .blue-shadow {
            box-shadow: 0 0 12px rgba(13, 91, 221, 0.35)
