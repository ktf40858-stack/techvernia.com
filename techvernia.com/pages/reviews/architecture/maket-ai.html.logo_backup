        .faq-answer { color: var(--text-secondary); line-height: 1.7; }
        .maket-highlight { background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(167, 139, 250, 0.05)); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: var(--radius-lg); padding: var(--space-lg); margin: var(--space-lg) 0; }
        .maket-highlight h4 { color: #8B5CF6; margin-bottom: var(--space-sm); }
        .use-case-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-md); margin-top: var(--space-lg); }
        .use-case-item { background: var(--bg-tertiary); padding: var(--space-lg); border-radius: var(--radius-lg); text-align: center; }
        .use-case-item .icon { font-size: var(--text-2xl); margin-bottom: var(--space-sm); }
        .use-case-item h4 { font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-xs); }
        .use-case-item p { font-size: var(--text-xs); color: var(--text-tertiary); margin: 0; }
        .pricing-table { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-lg); margin-top: var(--space-lg); }
        .pricing-tier { background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: var(--space-xl); }
        .pricing-tier.featured { border-color: #8B5CF6; background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(167, 139, 250, 0.05)); }
        .pricing-tier h4 { font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--space-sm); }
        .pricing-tier .price { font-size: var(--text-3xl); font-weight: 800; color: var(--text-primary); margin: var(--space-md) 0; }
        .pricing-tier ul { list-style: none; padding: 0; margin: var(--space-lg) 0; }
        .pricing-tier li { padding: var(--space-xs) 0; color: var(--text-secondary); font-size: var(--text-sm); }
        .comparison-table { width: 100%; border-collapse: collapse; margin-top: var(--space-lg); }
        .comparison-table th, .comparison-table td { padding: var(--space-md); text-align: left; border-bottom: 1px solid var(--border-color); }
        .comparison-table th { font-weight: 600; color: var(--text-primary); }
        .comparison-table td { color: var(--text-secondary); }
        @media (max-width: 968px) { .review-layout { grid-template-columns: 1fr; } .review-sidebar { position: static; order: -1; } .review-hero-content { grid-template-columns: 1fr; text-align: center; } .review-logo { margin: 0 auto; } .review-meta { justify-content: center; } .pros-cons-grid { grid-template-columns: 1fr; } .pricing-table { grid-template-columns: 1fr; } }
