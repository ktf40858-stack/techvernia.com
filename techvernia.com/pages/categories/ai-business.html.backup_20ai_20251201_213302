    <style>
        .category-hero {
            padding: calc(80px + var(--space-4xl)) var(--space-lg) var(--space-3xl);
            background: linear-gradient(135deg, rgba(0, 217, 255, 0.05) 0%, transparent 50%);
        }
        .category-hero-content {
            max-width: 800px;
        }
        .category-hero .hero-badge {
            margin-bottom: var(--space-lg);
        }
        .category-hero h1 {
            font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
            font-weight: 800;
            margin-bottom: var(--space-lg);
        }
        .category-hero p {
            font-size: var(--text-lg);
            color: var(--text-secondary);
            line-height: 1.7;
        }
        .tools-filter {
            display: flex;
            gap: var(--space-sm);
            flex-wrap: wrap;
            margin-bottom: var(--space-2xl);
        }
        .filter-btn {
            padding: var(--space-sm) var(--space-lg);
            background: var(--bg-tertiary);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-full);
            font-size: var(--text-sm);
            color: var(--text-secondary);
            cursor: pointer;
            transition: all var(--transition-fast);
        }
        .filter-btn:hover, .filter-btn.active {
            background: var(--gradient-primary);
            border-color: transparent;
            color: var(--bg-primary);
        }
        .tools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: var(--space-lg);
        }
        .tool-card-full {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-xl);
            overflow: hidden;
            transition: all var(--transition-normal);
        }
        .tool-card-full:hover {
            transform: translateY(-5px);
            border-color: var(--border-color-hover);
            box-shadow: var(--shadow-glow);
        }
        .tool-card-header {
            padding: var(--space-xl);
            background: var(--bg-tertiary);
            display: flex;
            align-items: center;
            gap: var(--space-lg);
        }
        .tool-logo-large {
            width: 72px;
            height: 72px;
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: var(--text-2xl);
            color: white;
            background-size: 60% !important;
            background-position: center !important;
            background-repeat: no-repeat !important;
        }
        .tool-logo-large.hubspot { background: url('../../images/logos/business/hubspot.png') center/60% no-repeat, linear-gradient(135deg, #FF7A59, #FF5733); }
        .tool-logo-large.salesforce { background: url('../../images/logos/business/salesforce.png') center/60% no-repeat, linear-gradient(135deg, #00A1E0, #0080C0); }.tool-logo-large.chorus { background: url('../../images/logos/business/chorus.png') center/60% no-repeat, linear-gradient(135deg, #10B981, #059669); }.tool-header-info h3 {
            font-size: var(--text-xl);
            font-weight: 700;
            margin-bottom: var(--space-xs);
        }
        .tool-header-info .company {
            font-size: var(--text-sm);
            color: var(--text-tertiary);
        }
        .tool-card-body {
            padding: var(--space-xl);
        }
        .tool-description {
            color: var(--text-secondary);
            line-height: 1.7;
            margin-bottom: var(--space-lg);
        }
        .tool-features-list {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-sm);
            margin-bottom: var(--space-lg);
        }
        .feature-tag {
            padding: var(--space-xs) var(--space-sm);
            background: rgba(0, 217, 255, 0.1);
            border-radius: var(--radius-sm);
            font-size: var(--text-xs);
            color: var(--accent-primary);
        }
        .tool-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: var(--space-md);
            padding: var(--space-lg);
            background: var(--bg-tertiary);
            border-radius: var(--radius-lg);
            margin-bottom: var(--space-lg);
        }
        .stat-item {
            text-align: center;
        }
        .stat-value {
            font-size: var(--text-lg);
            font-weight: 700;
            color: var(--text-primary);
        }
        .stat-label {
            font-size: var(--text-xs);
            color: var(--text-tertiary);
        }
        .tool-pricing-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--space-md) 0;
            border-top: 1px solid var(--border-color);
        }
        .pricing-info {
            display: flex;
            align-items: baseline;
            gap: var(--space-sm);
        }
        .pricing-info .price {
            font-size: var(--text-xl);
            font-weight: 700;
            color: var(--accent-primary);
        }
        .pricing-info .period {
            font-size: var(--text-sm);
            color: var(--text-tertiary);
        }
        .tool-actions {
            display: flex;
            gap: var(--space-sm);
        }
        .pros-cons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--space-lg);
            margin: var(--space-lg) 0;
        }
        .pros h4, .cons h4 {
            font-size: var(--text-sm);
            font-weight: 600;
            margin-bottom: var(--space-sm);
        }
        .pros h4 { color: var(--accent-tertiary); }
        .cons h4 { color: var(--accent-error); }
        .pros ul li, .cons ul li {
            font-size: var(--text-sm);
            color: var(--text-secondary);
            padding: var(--space-xs) 0;
            padding-left: var(--space-lg);
            position: relative;
        }
        .pros ul li::before {
            content: '✓';
            position: absolute;
            left: 0;
            color: var(--accent-tertiary);
        }
        .cons ul li::before {
            content: '✗';
            position: absolute;
            left: 0;
            color: var(--accent-error);
        }
        .comparison-table {
            width: 100%;
            border-collapse: collapse;
            margin: var(--space-2xl) 0;
        }
        .comparison-table th, .comparison-table td {
            padding: var(--space-md);
            text-align: left;
            border-bottom: 1px solid var(--border-color);
        }
        .comparison-table th {
            font-weight: 600;
            color: var(--text-primary);
            background: var(--bg-tertiary);
        }
        .comparison-table td {
            color: var(--text-secondary);
        }
        .check-icon { color: var(--accent-tertiary); }
        .cross-icon { color: var(--accent-error); }
        .hero-badge svg {
            width: 20px;
            height: 20px;
            vertical-align: middle;
            margin-right: 8px;
        }
        @media (max-width: 768px) {
            .tools-grid { grid-template-columns: 1fr; }
            .pros-cons { grid-template-columns: 1fr; }
            .tool-stats { grid-template-columns: 1fr; }
        }
