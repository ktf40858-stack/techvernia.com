    <div role="complementary"
         id="srf-browser-unhappy"
         class="srf-browser-unhappy">
        
            <p>
                <b>Your browser or operating system is out of date and Semrush might not be displayed correctly.</b> Please update your browser or operating system.
            </p>
        
        <button id="srf-browser-unhappy-btn-close"
                class="srf-browser-unhappy--btn-close">
            <svg width="16"
                 height="16"
                 viewBox="0 0 16 16"
                 class="srf-icon"
                 aria-label="Close outdated browser notice">
                <path d="M3.323 3.323c-.43.43-.43 1.128 0 1.559L6.44 8l-3.118 3.118a1.102 1.102 0 1 0 1.559 1.56L8 9.558l3.118 3.118a1.102 1.102 0 0 0 1.56-1.559L9.558 8l3.118-3.118a1.102 1.102 0 0 0-1.559-1.56L8 6.442 4.882 3.323a1.102 1.102 0 0 0-1.56 0Z" shape-rendering="geometricPrecision">
                </path>
            </svg>
        </button>
    </div>
    <script>
    (function () {
      var el = document.getElementById("srf-browser-unhappy");
      var closeBtn = document.getElementById("srf-browser-unhappy-btn-close");

      function handler() {
        var d = new Date();
        // we don't use max-age here because it's not supported by IE < 9
        d.setTime(d.getTime() + 2592000000); // 30 days
        document.cookie =
          "browser-unhappy-closed=true; expires=" +
          d.toGMTString() +
          "; path=/; domain=.semrush.com;";
        el.setAttribute("class", "srf-browser-unhappy--hide");
      }

      if (closeBtn.attachEvent) {
        closeBtn.attachEvent("onclick", handler);
      } else {
        closeBtn.addEventListener("click", handler);
      }
    })();
    </script>
    <!--googleon: all-->


                    



                    


                    
    




